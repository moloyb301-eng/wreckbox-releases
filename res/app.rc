// Resources: app icon, the two UI fonts (embedded so nothing needs installing), version info.
#include <winres.h>
#include "resource.h"

IDI_APP ICON "app_icon.ico"
IDR_FONT_URBANIST RCDATA "Urbanist.ttf"
IDR_FONT_DOTO RCDATA "Doto.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WB_VER_COMMA
 PRODUCTVERSION WB_VER_COMMA
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "local.wreckbox"
      VALUE "FileDescription", "WreckBox"
      VALUE "FileVersion", WB_VERSION
      VALUE "ProductName", "wreckbox"
      VALUE "ProductVersion", WB_VERSION
      VALUE "OriginalFilename", "wreckbox.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
